// Real loopback UDP and TCP, actual Worker/UDP framing, accelerated clock and a recovery seam.
#include <algorithm>
#include <atomic>
#include <cassert>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <mutex>
#include <thread>
#include <poll.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <unistd.h>
#include "udp_heartbeat.hpp"
#include "transport_recovery.hpp"
using namespace ams::mitm::lanywhere;
using u8 = uint8_t;
using u16 = uint16_t;
using u32 = uint32_t;
using u64 = uint64_t;
using s64 = int64_t;
constexpr size_t MaxPayload = 1472;
constexpr u32 UdpMagic = 0x594e414c, CapabilityFragment = 4, CapabilityHeartbeat = 8;
enum { U_Register=1, U_KeepAlive=3, U_RegisterV2=4, U_Heartbeat=6, U_Registered=0x81,
       U_DataIn=0x82, U_RegisteredV2=0x84, U_DataFragmentIn=0x85, U_HeartbeatAck=0x86,
       T_Ping=5, T_Pong=0x86 };
static const auto began = std::chrono::steady_clock::now();
namespace os {
struct TimeSpan {
    s64 ms;
    s64 GetMilliSeconds() const { return ms; }
    bool operator>=(TimeSpan other) const { return ms >= other.ms; }
};
struct Tick { s64 ms; TimeSpan ToTimeSpan() const { return {ms}; } };
Tick operator-(Tick a, Tick b) { return {a.ms - b.ms}; }
Tick GetSystemTick() {
    return {50 * std::chrono::duration_cast<std::chrono::milliseconds>(
        std::chrono::steady_clock::now() - began).count()};
}
}
static os::TimeSpan KeepAliveInterval{5000};
static os::Tick g_last_keepalive{};
enum class RelayState { Idle, Connecting, InRoom, Error };
static RelayState g_state = RelayState::InRoom;
static std::mutex g_lock, g_send_lock;
static std::atomic<u64> g_stream_epoch{1};
static std::atomic<bool> g_stream_ready{true};
static int g_tcp = -1, g_udp = -1, g_received = 0;
static sockaddr_in g_server{};
static u32 g_udp_features = 0, g_token = 0x12345678, g_heartbeat_sequence = 0;
static unsigned g_send_retries = 0, g_send_failures = 0;
static bool g_recovering = false;
static char g_error[64]{};
static std::atomic<bool> stop_peer{false}, recovered{false};
static std::atomic<unsigned> registrations{0}, keepalives{0}, control_pings{0};
static unsigned reconnect_calls = 0, enqueued = 0, mode;
static u16 initial_port = 0, restored_port = 0;
static int peer_udp = -1, peer_tcp = -1, spoof_udp = -1;
static u32 le32(const u8 *b) { return u32(b[0]) | (u32(b[1])<<8) | (u32(b[2])<<16) | (u32(b[3])<<24); }
static u16 le16(const u8 *b) { return u16(b[0]) | (u16(b[1])<<8); }
static void put32(u8 *b, u32 value) { for (unsigned i=0; i<4; ++i) b[i]=value>>(8*i); }
static void Log(const char *, ...) {}
static void Enqueue(const u8 *data, size_t size) { assert(size==14 && data[13]==0x5a); enqueued++; }
static void EnqueueDatagram(u32, u16, u16, const u8 *, size_t) { assert(false); }
struct Fragments {
    template<class F> void Push(u32,u16,u16,u32,u16,u16,const u8*,size_t,u64,F) { assert(false); }
    void Reset() {}
};
static Fragments g_fragments;
namespace util { void Strlcpy(char *out, const char *in, size_t size) { std::snprintf(out,size,"%s",in); } }
static void svcSleepThread(long) { std::this_thread::sleep_for(std::chrono::microseconds(10)); }
static void SetError(const char *text) { util::Strlcpy(g_error,text,sizeof(g_error)); g_state=RelayState::Error; }
static void CloseSockets() { g_stream_ready=false; close(g_tcp); close(g_udp); }
static void RefreshHostMetadata() {}
static void HandleFrame(u8 type,const u8 *,size_t,u64) { assert(type==T_Pong); }
static bool SendFrame(int type,const u8 *,size_t) {
    const u8 frame[]{1,0,static_cast<u8>(type)};
    return ::send(g_tcp,frame,sizeof(frame),0)==sizeof(frame);
}
static ssize_t ReadFrame(int fd,u8 *type,u8 *,size_t,int) {
    u8 frame[3];
    const auto n=::recv(fd,frame,sizeof(frame),MSG_WAITALL);
    if(n!=3 || frame[0]!=1 || frame[1]) return -1;
    *type=frame[2]; return 0;
}
static int boundUdp() {
    const int fd=::socket(AF_INET,SOCK_DGRAM,0);
    assert(fd>=0);
    sockaddr_in bind_address{}; bind_address.sin_family=AF_INET;
    bind_address.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
    assert(::bind(fd,reinterpret_cast<sockaddr *>(&bind_address),sizeof(bind_address))==0);
    return fd;
}
static RecoveryResult Reconnect() {
    reconnect_calls++;
    assert(reconnect_calls==1);
    assert(g_token==0x12345678 && g_server.sin_addr.s_addr==htonl(INADDR_LOOPBACK));
    // The real Reconnect identity/retry state machine is tested separately. This
    // seam installs a fresh UDP socket on the same peer and restores its path.
    const int replacement=boundUdp();
    close(g_udp); g_udp=replacement;
    g_stream_epoch++;
    recovered=true;
    g_recovering=false;
    g_last_keepalive=os::GetSystemTick();
    return RecoveryResult::Resumed;
}
static int scaledPoll(pollfd *fds,nfds_t count,int milliseconds) {
    return ::poll(fds,count,std::max(1,milliseconds/50));
}
static ssize_t testSendTo(int fd,const void *data,size_t size,int flags,const sockaddr *dest,socklen_t length) {
    if(mode==5 && !recovered) { errno=ENETDOWN; return -1; }
    return ::sendto(fd,data,size,flags,dest,length);
}
#define poll scaledPoll
#define sendto testSendTo
/* ACTUAL_FUNCTIONS */
#undef poll
#undef sendto

static void peerLoop() {
    while(!stop_peer) {
        pollfd fds[]={{peer_tcp,POLLIN,0},{peer_udp,POLLIN,0}};
        if(::poll(fds,2,10)<0) continue;
        if(fds[0].revents&POLLIN) {
            u8 frame[3]; const auto size=::recv(peer_tcp,frame,3,MSG_WAITALL);
            if(size!=3) break;
            assert(frame[0]==1 && frame[1]==0 && frame[2]==T_Ping);
            frame[2]=T_Pong; assert(::send(peer_tcp,frame,3,0)==3); control_pings++;
        }
        if(fds[1].revents&POLLIN) {
            u8 packet[1600]; sockaddr_in sender{}; socklen_t length=sizeof(sender);
            const auto size=::recvfrom(peer_udp,packet,sizeof(packet),0,reinterpret_cast<sockaddr *>(&sender),&length);
            assert(size>=9 && le32(packet)==UdpMagic && le32(packet+5)==g_token);
            if(recovered) restored_port=sender.sin_port;
            if(packet[4]==U_KeepAlive) { keepalives++; continue; }
            assert(packet[4]==U_Register && size==9);
            const unsigned request=++registrations;
            u8 ack[5]; put32(ack,UdpMagic); ack[4]=U_Registered;
            if(!recovered && mode==3) {
                // Source mismatch and a malformed acknowledgement from the right
                // endpoint must not satisfy the actual worker's pending probe.
                ::sendto(spoof_udp,ack,5,0,reinterpret_cast<sockaddr *>(&sender),length);
                ack[4]=U_HeartbeatAck;
                ::sendto(peer_udp,ack,5,0,reinterpret_cast<sockaddr *>(&sender),length);
                continue;
            }
            if(!recovered && (mode==2 || mode==6)) continue;
            u8 game[14]{}; put32(game,UdpMagic); game[4]=U_DataIn; game[13]=0x5a;
            ::sendto(peer_udp,game,sizeof(game),0,reinterpret_cast<sockaddr *>(&sender),length);
            // Two consecutive lost replies are tolerated. Duplicate replies do
            // not create an outstanding probe or carry over to the next socket.
            if(mode==7 && request%3) continue;
            ::sendto(peer_udp,ack,5,0,reinterpret_cast<sockaddr *>(&sender),length);
            ::sendto(peer_udp,ack,5,0,reinterpret_cast<sockaddr *>(&sender),length);
        }
        const s64 elapsed=os::GetSystemTick().ms;
        if(elapsed >= (mode==6 ? 12000 : 65000)) {
            std::scoped_lock lock(g_lock); g_state=RelayState::Idle;
            stop_peer=true;
        }
    }
}
int main(int argc,char **argv) {
    assert(argc==2); mode=std::atoi(argv[1]);
    if(mode==4) g_udp_features=CapabilityFragment;
    const int listener=::socket(AF_INET,SOCK_STREAM,0);
    assert(listener>=0);
    sockaddr_in control_address{}; control_address.sin_family=AF_INET;
    control_address.sin_addr.s_addr=htonl(INADDR_LOOPBACK);
    assert(::bind(listener,reinterpret_cast<sockaddr *>(&control_address),sizeof(control_address))==0);
    assert(::listen(listener,1)==0);
    socklen_t control_size=sizeof(control_address);
    assert(::getsockname(listener,reinterpret_cast<sockaddr *>(&control_address),&control_size)==0);
    g_tcp=::socket(AF_INET,SOCK_STREAM,0);
    assert(g_tcp>=0 && ::connect(g_tcp,reinterpret_cast<sockaddr *>(&control_address),sizeof(control_address))==0);
    peer_tcp=::accept(listener,nullptr,nullptr); assert(peer_tcp>=0); close(listener); g_udp=boundUdp(); peer_udp=boundUdp(); spoof_udp=boundUdp();
    socklen_t size=sizeof(g_server);
    assert(::getsockname(peer_udp,reinterpret_cast<sockaddr *>(&g_server),&size)==0);
    sockaddr_in local{}; size=sizeof(local);
    assert(::getsockname(g_udp,reinterpret_cast<sockaddr *>(&local),&size)==0);
    initial_port=local.sin_port;
    u8 stale[5]; put32(stale,UdpMagic); stale[4]=U_Registered;
    ::sendto(peer_udp,stale,sizeof(stale),0,reinterpret_cast<sockaddr *>(&local),sizeof(local));
    std::thread peer(peerLoop);
    Worker(nullptr);
    stop_peer=true; peer.join();
    close(peer_tcp); close(peer_udp); close(spoof_udp);
    const bool should_recover=mode==2 || mode==3 || mode==5;
    assert(reconnect_calls==static_cast<unsigned>(should_recover));
    assert(control_pings>= (mode==6 ? 2u : 8u));
    if(should_recover) assert(enqueued>=4 && restored_port && restored_port!=initial_port);
    if(mode==1 || mode==7) assert(registrations>=8 && enqueued>=8);
    if(mode==4) assert(registrations==0 && keepalives>=8);
    assert(g_state==RelayState::Idle && !g_error[0]);
    std::printf("PASS real-socket mode %u: registers=%u, control=%u, game=%u, recovery=%u\n",
                mode,registrations.load(),control_pings.load(),enqueued,reconnect_calls);
}
