+        @Composable
+        private fun LocalWirelessServerSetting() {
+            val file = remember { AtomicFile(File(MainActivity.AppPath, "local-wireless-server.txt")) }
+            val saved = remember {
+                mutableStateOf(try {
+                    if (file.baseFile.length() <= 256) file.readFully().decodeToString().trim() else ""
+                } catch (_: IOException) {
+                    ""
+                })
+            }
+            val edit = remember { mutableStateOf(saved.value) }
+            val error = remember { mutableStateOf(false) }
+            val host = edit.value.trim()
+            val valid = host.isEmpty() || host.split('.').all {
+                it.matches(Regex("[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"))
+            }
+            Column(modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp)) {
+                OutlinedTextField(
+                    value = edit.value,
+                    onValueChange = { if (it.length <= 253) edit.value = it },
+                    modifier = Modifier.fillMaxWidth(),
+                    label = { Text("Local wireless server") },
+                    placeholder = { Text("Off") },
+                    singleLine = true,
+                    isError = !valid || error.value
+                )
+                Button(enabled = valid && saved.value != host, onClick = {
+                    error.value = try {
+                        val stream = file.startWrite()
+                        try {
+                            stream.write(host.encodeToByteArray())
+                            file.finishWrite(stream)
+                        } catch (failure: IOException) {
+                            file.failWrite(stream)
+                            throw failure
+                        }
+                        saved.value = host
+                        false
+                    } catch (_: IOException) {
+                        true
+                    }
+                }) {
+                    Text(if (error.value) "Retry" else "Save")
+                }
+            }
+        }
