+        private static string ReadLocalWirelessServer()
+        {
+            string path = Path.Combine(AppDataManager.BaseDirPath, "local-wireless-server.txt");
+            try
+            {
+                using FileStream file = File.OpenRead(path);
+                if (file.Length > 256)
+                {
+                    return string.Empty;
+                }
+
+                using StreamReader reader = new(file);
+                string host = reader.ReadToEnd().Trim();
+                return Uri.CheckHostName(host) is UriHostNameType.Dns or UriHostNameType.IPv4
+                    ? host
+                    : string.Empty;
+            }
+            catch (IOException)
+            {
+                return string.Empty;
+            }
+            catch (UnauthorizedAccessException)
+            {
+                return string.Empty;
+            }
+        }
