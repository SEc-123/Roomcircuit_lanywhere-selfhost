+public final class RoomCircuitDialog {
+    private static final int MAX_RESPONSE = 65536;
+    private static final String HEX_ID = "[0-9a-fA-F]{16}";
+
+    @FunctionalInterface
+    public interface DirectConnect {
+        void open(String host, int port);
+    }
+
+    public static void show(Activity activity, DirectConnect directConnect) {
+        new RoomCircuitDialog(activity, directConnect).open();
+    }
+
+    private final Activity activity;
+    private final DirectConnect directConnect;
+    private final SharedPreferences preferences;
+    private final ExecutorService io = Executors.newSingleThreadExecutor();
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final ArrayList<Integer> offsets = new ArrayList<>();
+    private final Set<String> alerted = new HashSet<>();
+    private AlertDialog dialog;
+    private EditText address;
+    private TextView endpointLabel, status, roomRows;
+    private RadioGroup events;
+    private Button refresh, create, ready, follow, findRooms, connect, prev, next;
+    private JSONArray rows = new JSONArray(), games = new JSONArray();
+    private JSONObject follows = new JSONObject();
+    private String origin = "", identity = "", endpointHost = "";
+    private int endpointPort, nextOffset = -1, currentRow = -1, followIndex;
+    private int readyBefore = 1800;
+    private long clockDifference;
+    private boolean busy, closed, optionsReady;
+
+    private RoomCircuitDialog(Activity activity, DirectConnect directConnect) {
+        this.activity = activity;
+        this.directConnect = directConnect;
+        preferences = activity.getSharedPreferences("roomcircuit_appointments", Activity.MODE_PRIVATE);
+        offsets.add(0);
+    }
+
+    private void open() {
+        LinearLayout layout = column();
+        layout.setPadding(dp(20), dp(6), dp(20), dp(6));
+        ScrollView scroll = new ScrollView(activity);
+        scroll.addView(layout);
+        address = input(layout, t(R.string.roomcircuit_service), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI);
+        address.setText(preferences.getString("origin", ""));
+        refresh = button(layout, t(R.string.roomcircuit_refresh), this::refresh);
+        endpointLabel = label(layout, "");
+        connect = button(layout, t(R.string.roomcircuit_direct_connect), () -> {
+            final String host = endpointHost;
+            final int port = endpointPort;
+            dialog.dismiss();
+            directConnect.open(host, port);
+        });
+        label(layout, t(R.string.roomcircuit_appointments_title));
+        events = new RadioGroup(activity);
+        layout.addView(events);
+        events.setOnCheckedChangeListener((group, id) -> {
+            final View selected = group.findViewById(id);
+            currentRow = selected != null && selected.getTag() instanceof Integer ? (Integer) selected.getTag() : -1;
+            roomRows.setText("");
+            updateControls();
+        });
+        LinearLayout pageButtons = new LinearLayout(activity);
+        layout.addView(pageButtons);
+        prev = button(pageButtons, t(R.string.roomcircuit_previous), () -> {
+            if (offsets.size() > 1) {
+                ArrayList<Integer> pages = new ArrayList<>(offsets);
+                pages.remove(pages.size() - 1);
+                loadPage(pages);
+            }
+        });
+        next = button(pageButtons, t(R.string.roomcircuit_next), () -> {
+            if (nextOffset >= 0) {
+                ArrayList<Integer> pages = new ArrayList<>(offsets);
+                pages.add(nextOffset);
+                loadPage(pages);
+            }
+        });
+        create = button(layout, t(R.string.roomcircuit_new_appointment), this::createForm);
+        ready = button(layout, t(R.string.roomcircuit_mark_ready), this::toggleReady);
+        follow = button(layout, t(R.string.roomcircuit_follow), this::toggleFollow);
+        findRooms = button(layout, t(R.string.roomcircuit_find_rooms), () -> loadRooms(selection().optString("id"), true));
+        roomRows = label(layout, "");
+        status = label(layout, t(R.string.roomcircuit_enter_service));
+        dialog = new AlertDialog.Builder(activity).setTitle(t(R.string.roomcircuit_appointments)).setView(scroll)
+                .setPositiveButton(t(R.string.roomcircuit_close), null).create();
+        dialog.setOnDismissListener(unused -> {
+            closed = true;
+            handler.removeCallbacksAndMessages(null);
+            io.shutdownNow();
+        });
+        updateControls();
+        dialog.show();
+        handler.postDelayed(poll, 12000);
+        if (!address.getText().toString().isEmpty()) {
+            refresh();
+        }
+    }
+
+    private final Runnable poll = new Runnable() {
+        @Override
+        public void run() {
+            if (closed) return;
+            updateControls();
+            if (!busy && sameOrigin() && optionsReady && follows.length() > 0) {
+                ArrayList<String> active = new ArrayList<>();
+                final Iterator<String> keys = follows.keys();
+                while (keys.hasNext()) {
+                    final String id = keys.next();
+                    final long starts = follows.optLong(id);
+                    if (starts > 0 && now() >= starts - readyBefore && now() < starts + 7200) active.add(id);
+                }
+                if (!active.isEmpty()) {
+                    loadRooms(active.get(followIndex % active.size()), false);
+                    followIndex = (followIndex + 1) % active.size();
+                }
+            }
+            handler.postDelayed(this, 12000);
+        }
+    };
+
+    private LinearLayout column() {
+        LinearLayout layout = new LinearLayout(activity);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        return layout;
+    }
+
+    private String t(int string, Object... values) {
+        return activity.getString(string, values);
+    }
+
+    private int dp(int pixels) {
+        return (int) (pixels * activity.getResources().getDisplayMetrics().density + 0.5f);
+    }
+
+    private TextView label(LinearLayout parent, String text) {
+        TextView view = new TextView(activity);
+        view.setText(text);
+        view.setPadding(0, dp(5), 0, dp(5));
+        parent.addView(view);
+        return view;
+    }
+
+    private EditText input(LinearLayout parent, String hint, int type) {
+        EditText view = new EditText(activity);
+        view.setInputType(type);
+        view.setSingleLine(true);
+        view.setHint(hint);
+        parent.addView(view);
+        return view;
+    }
+
+    private Button button(LinearLayout parent, String title, Runnable onClick) {
+        Button button = new Button(activity);
+        button.setText(title);
+        button.setOnClickListener(unused -> onClick.run());
+        parent.addView(button);
+        return button;
+    }
+
+    private static String parseOrigin(String input) {
+        try {
+            final URI uri = new URI(input.trim());
+            if (!"https".equalsIgnoreCase(uri.getScheme()) || uri.getHost() == null ||
+                    uri.getPort() == 0 || uri.getPort() > 65535 || uri.getUserInfo() != null ||
+                    uri.getQuery() != null || uri.getFragment() != null ||
+                    (uri.getPath() != null && !uri.getPath().isEmpty() && !"/".equals(uri.getPath()))) {
+                return "";
+            }
+            return new URI("https", null, uri.getHost().toLowerCase(Locale.ROOT), uri.getPort(), null, null, null).toASCIIString();
+        } catch (Exception ignored) {
+            return "";
+        }
+    }
+
+    private long now() {
+        return System.currentTimeMillis() / 1000 + clockDifference;
+    }
+
+    private boolean sameOrigin() {
+        return !origin.isEmpty() && origin.equals(parseOrigin(address.getText().toString()));
+    }
+
+    private JSONObject selection() {
+        JSONObject row = rows.optJSONObject(currentRow);
+        return row == null ? new JSONObject() : row;
+    }
+
+    private void updateControls() {
+        final JSONObject selected = selection();
+        final String id = selected.optString("id");
+        final long start = selected.optLong("starts");
+        final boolean active = start > 0 && now() >= start - readyBefore && now() < start + 7200;
+        final boolean alreadyReady = selected.optBoolean("ready");
+        final boolean current = !busy && sameOrigin();
+        refresh.setEnabled(!busy);
+        address.setEnabled(!busy);
+        create.setEnabled(current && optionsReady);
+        connect.setEnabled(current && endpointPort != 0);
+        findRooms.setEnabled(current && active);
+        ready.setText(alreadyReady ? t(R.string.roomcircuit_cancel_ready) : t(R.string.roomcircuit_mark_ready));
+        ready.setEnabled(current && (active || alreadyReady));
+        follow.setText(follows.has(id) ? t(R.string.roomcircuit_unfollow) : t(R.string.roomcircuit_follow));
+        follow.setEnabled(current && !id.isEmpty());
+        prev.setEnabled(current && offsets.size() > 1);
+        next.setEnabled(current && nextOffset >= 0);
+        for (int i = 0; i < events.getChildCount(); i++) events.getChildAt(i).setEnabled(current);
+    }
+
+    @FunctionalInterface
+    private interface Completion {
+        void accept(JSONObject response) throws JSONException;
+    }
+
+    private static JSONObject data(Object... fields) {
+        final JSONObject json = new JSONObject();
+        try {
+            for (int i = 0; i < fields.length; i += 2) json.put((String) fields[i], fields[i + 1]);
+        } catch (JSONException error) {
+            throw new IllegalArgumentException(error);
+        }
+        return json;
+    }
+
+    private void request(String path, JSONObject payload, Completion completion) {
+        final String target = origin + path;
+        final byte[] body = payload == null ? null : payload.toString().getBytes(StandardCharsets.UTF_8);
+        busy = true;
+        updateControls();
+        io.execute(() -> {
+            JSONObject response = null;
+            String error = t(R.string.roomcircuit_network_error);
+            HttpURLConnection connection = null;
+            try {
+                connection = (HttpURLConnection) new URI(target).toURL().openConnection();
+                connection.setConnectTimeout(8000);
+                connection.setReadTimeout(8000);
+                connection.setInstanceFollowRedirects(false);
+                connection.setUseCaches(false);
+                if (body != null) {
+                    connection.setRequestMethod("POST");
+                    connection.setDoOutput(true);
+                    connection.setRequestProperty("Content-Type", "application/json");
+                    connection.setRequestProperty("X-RoomCircuit-Client", "native-v1");
+                    connection.setFixedLengthStreamingMode(body.length);
+                    try (OutputStream out = connection.getOutputStream()) {
+                        out.write(body);
+                    }
+                }
+                final int code = connection.getResponseCode();
+                if (code == 200 || code >= 400) {
+                    try (InputStream in = code == 200 ? connection.getInputStream() : connection.getErrorStream()) {
+                        if (in != null) {
+                            ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+                            final byte[] buffer = new byte[4096];
+                            for (int n; (n = in.read(buffer)) != -1;) {
+                                if (bytes.size() + n > MAX_RESPONSE) throw new IllegalStateException("Response limit");
+                                bytes.write(buffer, 0, n);
+                            }
+                            final JSONObject json = new JSONObject(new String(bytes.toByteArray(), StandardCharsets.UTF_8));
+                            if (code == 200 && !json.has("error")) {
+                                response = json;
+                            } else {
+                                switch (json.optString("error")) {
+                                    case "not_found": error = t(R.string.roomcircuit_appointment_expired); break;
+                                    case "invalid": error = t(R.string.roomcircuit_invalid_request); break;
+                                    case "limit": error = t(R.string.roomcircuit_rate_limited); break;
+                                    case "unavailable": error = t(R.string.roomcircuit_relay_not_ready); break;
+                                }
+                            }
+                        }
+                    }
+                }
+            } catch (Exception ignored) {
+                // Display the concise network error and allow a retry.
+            } finally {
+                if (connection != null) connection.disconnect();
+            }
+            final JSONObject result = response;
+            final String statusMessage = error;
+            handler.post(() -> {
+                if (closed) return;
+                busy = false;
+                if (result == null) {
+                    status.setText(statusMessage);
+                } else {
+                    final long serverNow = result.optLong("now");
+                    if (serverNow > 0) clockDifference = serverNow - System.currentTimeMillis() / 1000;
+                    try {
+                        completion.accept(result);
+                    } catch (JSONException failure) {
+                        status.setText(t(R.string.roomcircuit_invalid_response));
+                    }
+                }
+                updateControls();
+            });
+        });
+    }
+
+    private void post(JSONObject payload, Completion completion) {
+        if (closed || busy || !sameOrigin()) return;
+        try {
+            payload.put("identity", identity);
+        } catch (JSONException error) {
+            throw new IllegalStateException(error);
+        }
+        request("/api/appointments/native", payload, completion);
+    }
+
+    private void refresh() {
+        if (busy) return;
+        final String candidate = parseOrigin(address.getText().toString());
+        if (candidate.isEmpty()) {
+            status.setText(t(R.string.roomcircuit_https_required));
+            return;
+        }
+        if (!candidate.equals(origin)) {
+            origin = candidate;
+            identity = preferences.getString("identity:" + origin, "");
+            if (!identity.matches("[a-f0-9]{32}") || identity.matches("0+")) {
+                byte[] bytes = new byte[16];
+                new SecureRandom().nextBytes(bytes);
+                StringBuilder output = new StringBuilder();
+                for (byte b : bytes) output.append(String.format(Locale.ROOT, "%02x", b & 0xff));
+                identity = output.toString();
+                preferences.edit().putString("identity:" + origin, identity).apply();
+            }
+            try {
+                follows = new JSONObject(preferences.getString("follows:" + origin, "{}"));
+            } catch (JSONException ignored) {
+                follows = new JSONObject();
+            }
+            alerted.clear();
+            rows = new JSONArray();
+            events.removeAllViews();
+            currentRow = -1;
+            nextOffset = -1;
+        }
+        optionsReady = false;
+        endpointHost = "";
+        endpointPort = 0;
+        endpointLabel.setText("");
+        preferences.edit().putString("origin", origin).apply();
+        status.setText(t(R.string.roomcircuit_connecting));
+        request("/api/appointments/options", null, result -> {
+            if (result.optInt("nativeApi") != 1) {
+                status.setText(t(R.string.roomcircuit_update_relay));
+                return;
+            }
+            games = result.getJSONArray("games");
+            readyBefore = Math.max(0, Math.min(result.optInt("readyBefore", 1800), 86400));
+            final JSONArray endpoints = result.getJSONArray("endpoints");
+            for (int i = 0; i < endpoints.length(); i++) {
+                final JSONObject endpoint = endpoints.getJSONObject(i);
+                final String host = endpoint.optString("host");
+                final int port = endpoint.optInt("port");
+                if ("eden".equals(endpoint.optString("id")) && host.matches("[A-Za-z0-9.-]{1,253}") &&
+                        port > 0 && port <= 65535) {
+                    endpointHost = host;
+                    endpointPort = port;
+                    break;
+                }
+            }
+            endpointLabel.setText(endpointPort == 0 ? t(R.string.roomcircuit_no_eden_listener)
+                    : t(R.string.roomcircuit_game_relay, endpointHost, endpointPort));
+            optionsReady = true;
+            loadFirstPage();
+        });
+    }
+
+    private void loadFirstPage() {
+        ArrayList<Integer> first = new ArrayList<>();
+        first.add(0);
+        loadPage(first);
+    }
+
+    private void loadPage(ArrayList<Integer> pages) {
+        final String selected = selection().optString("id");
+        post(data("action", "list", "offset", pages.get(pages.size() - 1)), response -> {
+            if (pages.size() > 1 && response.getJSONArray("rows").length() == 0) {
+                loadFirstPage();
+                return;
+            }
+            offsets.clear();
+            offsets.addAll(pages);
+            renderRows(response, selected);
+        });
+    }
+
+    private String gameName(JSONObject entry) {
+        final String game = entry.optString("game");
+        final String app = entry.optString("app");
+        for (int i = 0; i < games.length(); i++) {
+            final JSONObject option = games.optJSONObject(i);
+            if (option != null && game.equalsIgnoreCase(option.optString("game")) &&
+                    app.equalsIgnoreCase(option.optString("app"))) {
+                return Locale.getDefault().getLanguage().equals("zh") && !option.optString("zh").isEmpty()
+                        ? option.optString("zh") : option.optString("name");
+            }
+        }
+        return game.toUpperCase(Locale.ROOT);
+    }
+
+    private void renderRows(JSONObject response, String selected) throws JSONException {
+        rows = response.getJSONArray("rows");
+        nextOffset = response.optInt("next", -1);
+        events.removeAllViews();
+        currentRow = -1;
+        RadioButton select = null;
+        final DateFormat calendar = DateFormat.getDateTimeInstance(DateFormat.MEDIUM, DateFormat.SHORT);
+        for (int i = 0; i < rows.length(); i++) {
+            final JSONObject row = rows.getJSONObject(i);
+            RadioButton item = new RadioButton(activity);
+            item.setId(View.generateViewId());
+            item.setTag(i);
+            item.setText(t(R.string.roomcircuit_event_row, gameName(row),
+                    calendar.format(new Date(1000 * row.getLong("starts"))), row.getInt("interested")) +
+                    (row.optBoolean("ready") ? " (" + t(R.string.roomcircuit_own_ready) + ")" : ""));
+            events.addView(item);
+            if (select == null || selected.equals(row.optString("id"))) select = item;
+        }
+        if (select != null) events.check(select.getId());
+        status.setText(rows.length() == 0 ? t(R.string.roomcircuit_no_appointments) : t(R.string.roomcircuit_local_time));
+        updateControls();
+    }
+
+    private void createForm() {
+        final LinearLayout fields = column();
+        fields.setPadding(dp(20), 0, dp(20), 0);
+        final Spinner titles = new Spinner(activity);
+        final ArrayList<String> choices = new ArrayList<>();
+        for (int i = 0; i < games.length(); i++) choices.add(gameName(games.optJSONObject(i)));
+        choices.add(t(R.string.roomcircuit_manual_ids));
+        titles.setAdapter(new ArrayAdapter<>(activity, android.R.layout.simple_spinner_dropdown_item, choices));
+        fields.addView(titles);
+        final EditText game = input(fields, t(R.string.roomcircuit_game_lcid), InputType.TYPE_CLASS_TEXT);
+        final EditText app = input(fields, t(R.string.roomcircuit_application_id), InputType.TYPE_CLASS_TEXT);
+        final EditText start = input(fields, t(R.string.roomcircuit_start_time), InputType.TYPE_CLASS_DATETIME);
+        final TextView error = label(fields, "");
+        final SimpleDateFormat format = new SimpleDateFormat("yyyy-MM-dd HH:mm", Locale.US);
+        format.setLenient(false);
+        start.setText(format.format(new Date(1000 * (now() + 1800))));
+        titles.setOnItemSelectedListener(new android.widget.AdapterView.OnItemSelectedListener() {
+            @Override
+            public void onItemSelected(android.widget.AdapterView<?> a, View v, int index, long id) {
+                final JSONObject entry = games.optJSONObject(index);
+                game.setText(entry == null ? "" : entry.optString("game"));
+                app.setText(entry == null ? "" : entry.optString("app"));
+                game.setEnabled(entry == null);
+                app.setEnabled(entry == null);
+            }
+
+            @Override
+            public void onNothingSelected(android.widget.AdapterView<?> a) {}
+        });
+        final AlertDialog editor = new AlertDialog.Builder(activity).setTitle(t(R.string.roomcircuit_create_title))
+                .setView(fields).setPositiveButton(t(R.string.roomcircuit_save), null).setNegativeButton(t(R.string.roomcircuit_cancel), null).create();
+        editor.show();
+        editor.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener(unused -> {
+            final String gameId = game.getText().toString().trim().toUpperCase(Locale.ROOT);
+            final String appId = app.getText().toString().trim().toUpperCase(Locale.ROOT);
+            final String when = start.getText().toString().trim();
+            final ParsePosition position = new ParsePosition(0);
+            final Date date = format.parse(when, position);
+            if (!gameId.matches(HEX_ID) || (!appId.isEmpty() && !appId.matches(HEX_ID))) {
+                error.setText(t(R.string.roomcircuit_invalid_game_id));
+                return;
+            }
+            if (date == null || position.getIndex() != when.length() || date.getTime() / 1000 < now() ||
+                    date.getTime() / 1000 > now() + 7L * 86400) {
+                error.setText(t(R.string.roomcircuit_invalid_start));
+                return;
+            }
+            editor.dismiss();
+            final JSONObject fieldsJson = data("action", "create", "game", gameId, "starts", date.getTime() / 1000);
+            if (!appId.isEmpty()) {
+                try {
+                    fieldsJson.put("app", appId);
+                } catch (JSONException exception) {
+                    throw new IllegalStateException(exception);
+                }
+            }
+            post(fieldsJson, reply -> {
+                offsets.clear();
+                offsets.add(0);
+                final JSONObject created = reply.optJSONObject("created");
+                renderRows(reply, created == null ? "" : created.optString("id"));
+                status.setText(t(R.string.roomcircuit_saved));
+            });
+        });
+    }
+
+    private void toggleReady() {
+        final JSONObject row = selection();
+        final String id = row.optString("id");
+        if (id.isEmpty()) return;
+        post(data("action", row.optBoolean("ready") ? "leave" : "ready", "id", id), reply -> {
+            offsets.clear();
+            offsets.add(0);
+            renderRows(reply, id);
+        });
+    }
+
+    private void toggleFollow() {
+        final JSONObject row = selection();
+        final String id = row.optString("id");
+        if (id.isEmpty()) return;
+        if (follows.has(id)) {
+            follows.remove(id);
+            alerted.remove(id);
+        } else {
+            Iterator<String> followedIds = follows.keys();
+            while (followedIds.hasNext()) {
+                final String old = followedIds.next();
+                if (follows.optLong(old) + 7200 <= now()) {
+                    followedIds.remove();
+                    alerted.remove(old);
+                }
+            }
+            if (follows.length() >= 24) {
+                status.setText(t(R.string.roomcircuit_follow_limit));
+                return;
+            }
+            try {
+                follows.put(id, row.optLong("starts"));
+            } catch (JSONException exception) {
+                throw new IllegalStateException(exception);
+            }
+        }
+        preferences.edit().putString("follows:" + origin, follows.toString()).apply();
+        updateControls();
+    }
+
+    private void loadRooms(String id, boolean explicit) {
+        if (id.isEmpty()) return;
+        post(data("action", "rooms", "id", id), reply -> {
+            final JSONArray active = reply.getJSONArray("rooms");
+            final StringBuilder text = new StringBuilder();
+            for (int i = 0; i < active.length(); i++) {
+                final JSONObject room = active.getJSONObject(i);
+                if (!room.optBoolean("crossplay")) continue;
+                text.append(room.optString("host")).append(" — ")
+                        .append(room.optInt("players")).append('/').append(room.optInt("max")).append(" — ")
+                        .append(room.optBoolean("appointmentBound") ? t(R.string.roomcircuit_bound_room) :
+                                room.optBoolean("titleConfirmed") ? t(R.string.roomcircuit_same_game) : t(R.string.roomcircuit_lcid_match))
+                        .append('\n');
+            }
+            final boolean hasRoom = text.length() > 0;
+            if (id.equals(selection().optString("id"))) {
+                roomRows.setText(hasRoom ? text.toString().trim() : t(R.string.roomcircuit_no_rooms));
+            }
+            if (!hasRoom) alerted.remove(id);
+            if (hasRoom && follows.has(id) && alerted.add(id)) status.setText(t(R.string.roomcircuit_follow_alert));
+            else if (explicit && hasRoom) status.setText(t(R.string.roomcircuit_join_in_game));
+        });
+    }
+}
