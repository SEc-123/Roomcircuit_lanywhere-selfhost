+            R_UNLESS(image != nullptr, ams::fs::ResultAllocationMemoryFailedNew());
+            R_TRY(fsFileRead(std::addressof(image_file), 0, image.get(), size, FsReadOption_None, std::addressof(read)));
+            R_UNLESS(read == size && private_certstore::ValidateImage(image.get(), size), ams::fs::ResultInvalidSize());
+
+            u8 actual_digest[32];
+            crypto::GenerateSha256(actual_digest, sizeof(actual_digest), image.get(), size);
+            R_UNLESS(private_certstore::MatchDigest(sidecar, actual_digest), ams::fs::ResultInvalidArgument());
+            *out_image = std::move(image);
+            *out_size = image_size;
+            R_SUCCEED();
