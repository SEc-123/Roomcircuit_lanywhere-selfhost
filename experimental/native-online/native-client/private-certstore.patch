+            char sidecar[private_certstore::SidecarSize];
+            R_UNLESS(digest_size == sizeof(sidecar), ams::fs::ResultInvalidSize());
+            u64 read;
+            R_TRY(fsFileRead(std::addressof(digest_file), 0, sidecar, sizeof(sidecar), FsReadOption_None, std::addressof(read)));
+            R_UNLESS(read == sizeof(sidecar), ams::fs::ResultInvalidSize());
+
+            FsFile image_file;
+            R_TRY(mitm::fs::OpenAtmosphereSdFile(std::addressof(image_file), private_certstore::ImagePath, OpenMode_Read));
