+            const auto bounded_size = std::min(service_size, size_t(6));
+            const auto *end = static_cast<const char *>(std::memchr(service, '\0', bounded_size));
+            if (end == nullptr || !roomcircuit::private_dns::ParseService(std::string_view(service, end - service), port)) {
+                return EAI_SERVICE;
+            }
