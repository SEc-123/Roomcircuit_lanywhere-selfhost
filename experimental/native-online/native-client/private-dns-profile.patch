+            if (fields.family != AF_UNSPEC && fields.family != AF_INET) {
+                return EAI_NONAME;
+            }
+            hint.ai_flags = static_cast<int>(fields.flags);
+            hint.ai_family = static_cast<int>(fields.family);
+            hint.ai_socktype = static_cast<int>(fields.socket_type);
+            hint.ai_protocol = static_cast<int>(fields.protocol);
+        }
+        if (output == nullptr || output_size == 0) {
+            return EAI_MEMORY;
+        }
