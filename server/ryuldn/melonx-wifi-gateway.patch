index 0000000..2c2ca23
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Ldn/UserServiceCreator/LdnMitm/RoomCircuitWifiRoute.cs
@@ -0,0 +1,43 @@
+using System.Net;
+using System.Net.Sockets;
+using System.Threading;
+
+namespace Ryujinx.HLE.HOS.Services.Ldn.UserServiceCreator.LdnMitm
+{
+    internal sealed class RoomCircuitWifiRoute
+    {
+        public static readonly IPAddress Address = IPAddress.Parse("10.13.254.254");
+        private static readonly IPAddress GameBroadcast = IPAddress.Parse("10.13.255.255");
+        private static RoomCircuitWifiRoute _active;
+        private readonly IPAddress _localBroadcast;
+
+        private RoomCircuitWifiRoute(IPAddress localBroadcast) => _localBroadcast = localBroadcast;
+
+        public static RoomCircuitWifiRoute ForInterface(bool enabled, IPAddress local, IPAddress localBroadcast)
+        {
+            byte[] octets = local.GetAddressBytes();
+            return enabled && octets.Length == 4 && octets[0] == 10 && octets[1] == 13
+                ? new RoomCircuitWifiRoute(localBroadcast)
+                : null;
+        }
+
+        public void Activate() => Interlocked.Exchange(ref _active, this);
+
+        public void Deactivate() => Interlocked.CompareExchange(ref _active, null, this);
+
+        public static IPEndPoint Map(SocketType socketType, IPEndPoint target)
+        {
+            var route = Volatile.Read(ref _active);
+            if (route == null || socketType != SocketType.Dgram || target == null ||
+                target.AddressFamily != AddressFamily.InterNetwork)
+            {
+                return target;
+            }
+
+            IPAddress ip = target.Address;
+            return ip.Equals(IPAddress.Broadcast) || ip.Equals(GameBroadcast) || ip.Equals(route._localBroadcast)
+                ? new IPEndPoint(Address, target.Port)
+                : target;
+        }
+    }
+}
